# Vercel Blob - get this from your Vercel project dashboard
# Go to: Storage → Blob → Create Store → connect to project
# This env var is auto-set when you connect a Blob store in Vercel
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Optional: set a secret token to protect the delete & upload endpoints
# Anyone with this token can upload/delete files
ADMIN_SECRET=change-me-to-something-secure

# Optional: set max file size in bytes (default: 50MB)
# MAX_FILE_SIZE=52428800
